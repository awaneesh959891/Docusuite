<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="MauiApp.Pages.DocumentsPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:models="clr-namespace:MauiApp.Models"
	xmlns:vm="clr-namespace:MauiApp.PageModels"
	x:DataType="vm:DocumentsViewModel"
	Title="My Documents"
	BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

	<ContentPage.Resources>
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="StrokeThickness" Value="1" />
			<Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#33333C}" />
			<Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource DarkSecondaryBackground}}" />
			<Setter Property="StrokeShape" Value="RoundRectangle 18" />
			<Setter Property="Padding" Value="12" />
		</Style>
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="12" MaximumWidthRequest="940">
			<Label Text="My Documents" FontSize="28" FontAttributes="Bold"
				   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=White}" />
			<Label Text="Offline workspace — files stay on this device." TextColor="{StaticResource Gray500}" />

			<Border Style="{StaticResource Card}" Padding="10">
				<Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8">
					<Button Text="＋ Add" Command="{Binding AddPdfCommand}" HeightRequest="38" CornerRadius="18" />
					<Button Grid.Column="1" Text="📁 Folder" Command="{Binding CreateFolderCommand}" HeightRequest="38" CornerRadius="18" />
					<Button Grid.Column="2" Text="↻" WidthRequest="42" Command="{Binding RefreshCommand}" HeightRequest="38" CornerRadius="18" />
					<Entry Grid.Column="3" Text="{Binding SearchText}" Placeholder="Search documents" ClearButtonVisibility="WhileEditing" />
					<Button Grid.Column="4" Text="{Binding ViewToggleLabel}" Command="{Binding ToggleViewCommand}" HeightRequest="38" CornerRadius="18" />
					<Button Grid.Column="5" Text="Select" Command="{Binding ToggleSelectionModeCommand}" HeightRequest="38" CornerRadius="18" />
				</Grid>
			</Border>

			<Grid ColumnDefinitions="*,*" ColumnSpacing="10">
				<Picker Title="Sort" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SortIndex}" />
				<Picker Grid.Column="1" Title="Tag" ItemsSource="{Binding TagOptions}" SelectedIndex="{Binding TagIndex}" />
			</Grid>

			<HorizontalStackLayout Spacing="10">
				<CheckBox IsChecked="{Binding ShowFavoritesOnly}" />
				<Label Text="Favorites" VerticalOptions="Center" />
				<CheckBox IsChecked="{Binding ShowPinnedOnly}" />
				<Label Text="Pinned" VerticalOptions="Center" />
				<Label Text="{Binding SelectedCount, StringFormat='Selected: {0}'}" VerticalOptions="Center" Margin="12,0,0,0" />
			</HorizontalStackLayout>

			<HorizontalStackLayout Spacing="8" IsVisible="{Binding HasSelection}">
				<Button Text="★ Favorite" Command="{Binding BatchFavoriteCommand}" HeightRequest="38" CornerRadius="18" />
				<Button Text="Share" Command="{Binding BatchShareCommand}" HeightRequest="38" CornerRadius="18" />
				<Button Text="Delete" Command="{Binding BatchDeleteCommand}" HeightRequest="38" CornerRadius="18" BackgroundColor="#EF4444" TextColor="White" />
			</HorizontalStackLayout>

			<Border Style="{StaticResource Card}" IsVisible="{Binding HasRecentDocuments}">
				<VerticalStackLayout Spacing="8">
					<Label Text="Recent documents" FontAttributes="Bold" />
					<HorizontalStackLayout BindableLayout.ItemsSource="{Binding RecentDocuments}" Spacing="8">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="models:WorkspaceDocument">
								<Border Style="{StaticResource Card}" WidthRequest="220" Padding="10">
									<Border.GestureRecognizers>
										<TapGestureRecognizer
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=OpenOrToggleCommand}"
											CommandParameter="{Binding .}" />
									</Border.GestureRecognizers>
									<VerticalStackLayout Spacing="4">
										<Label Text="{Binding Glyph}" FontSize="20" />
										<Label Text="{Binding FileName}" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
										<Label Text="{Binding Details}" FontSize="11" TextColor="{StaticResource Gray500}" />
									</VerticalStackLayout>
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</HorizontalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Border Style="{StaticResource Card}" IsVisible="{Binding HasContinueEditing}">
				<VerticalStackLayout Spacing="8">
					<Label Text="Continue editing" FontAttributes="Bold" />
					<CollectionView ItemsSource="{Binding ContinueEditing}" SelectionMode="None" HeightRequest="150">
						<CollectionView.ItemsLayout>
							<LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
						</CollectionView.ItemsLayout>
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="models:ContinueEditingItem">
								<Border Style="{StaticResource Card}" WidthRequest="240" Padding="10">
									<Border.GestureRecognizers>
										<TapGestureRecognizer
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=OpenContinueCommand}"
											CommandParameter="{Binding .}" />
									</Border.GestureRecognizers>
									<VerticalStackLayout Spacing="2">
										<Label Text="{Binding Glyph}" FontSize="20" />
										<Label Text="{Binding ToolTitle}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
										<Label Text="{Binding FileName}" FontSize="12" LineBreakMode="MiddleTruncation" />
										<Label Text="{Binding When}" FontSize="11" TextColor="{StaticResource Gray500}" />
									</VerticalStackLayout>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</VerticalStackLayout>
			</Border>

			<CollectionView ItemsSource="{Binding Documents}" SelectionMode="None" IsVisible="{Binding IsListMode}">
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:WorkspaceDocument">
						<Border Style="{StaticResource Card}">
							<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto">
								<CheckBox IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=IsSelectionMode}"
										  IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
								<Grid Grid.Column="1" ColumnDefinitions="76,*" ColumnSpacing="10">
									<Border WidthRequest="76" HeightRequest="98" StrokeThickness="0" BackgroundColor="#EEF2FF">
										<Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
										<Image Source="{Binding ThumbnailPath}" Aspect="AspectFill" />
									</Border>
									<VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
										<Label Text="{Binding FileName}" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
										<Label Text="{Binding Details}" FontSize="12" TextColor="{StaticResource Gray500}" />
										<HorizontalStackLayout Spacing="6">
											<Label Text="{Binding Tag}" FontSize="11" TextColor="{StaticResource Primary}" />
											<Label Text="{Binding FolderName}" FontSize="11" TextColor="{StaticResource Gray500}" />
											<Label Text="{Binding ModifiedLabel}" FontSize="11" TextColor="{StaticResource Gray500}" />
										</HorizontalStackLayout>
									</VerticalStackLayout>
								</Grid>
								<VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
									<Button Text="Open" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=OpenOrToggleCommand}"
											CommandParameter="{Binding .}" />
									<Button Text="Edit pages" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=EditPagesCommand}"
											CommandParameter="{Binding .}" />
									<Button Text="★" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=ToggleFavoriteCommand}"
											CommandParameter="{Binding .}" />
									<Button Text="📌" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=TogglePinnedCommand}"
											CommandParameter="{Binding .}" />
								</VerticalStackLayout>
								<HorizontalStackLayout Grid.Row="1" Grid.ColumnSpan="3" HorizontalOptions="End" Spacing="6" Margin="0,8,0,0">
									<Button Text="Tag" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=ChangeTagCommand}"
											CommandParameter="{Binding .}" />
									<Button Text="Rename" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=RenameCommand}"
											CommandParameter="{Binding .}" />
									<Button Text="Move" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=MoveCommand}"
											CommandParameter="{Binding .}" />
									<Button Text="Copy" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=DuplicateCommand}"
											CommandParameter="{Binding .}" />
									<Button Text="Share" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=ShareCommand}"
											CommandParameter="{Binding .}" />
									<Button Text="Delete" HeightRequest="32" BackgroundColor="#EF4444" TextColor="White"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=DeleteCommand}"
											CommandParameter="{Binding .}" />
								</HorizontalStackLayout>
							</Grid>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<CollectionView ItemsSource="{Binding Documents}" SelectionMode="None" IsVisible="{Binding IsGridMode}">
				<CollectionView.ItemsLayout>
					<GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
				</CollectionView.ItemsLayout>
				<CollectionView.ItemTemplate>
					<DataTemplate x:DataType="models:WorkspaceDocument">
						<Border Style="{StaticResource Card}">
							<Border.GestureRecognizers>
								<TapGestureRecognizer
									Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=OpenOrToggleCommand}"
									CommandParameter="{Binding .}" />
							</Border.GestureRecognizers>
							<VerticalStackLayout Spacing="6">
								<CheckBox IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=IsSelectionMode}"
									  IsChecked="{Binding IsSelected}" HorizontalOptions="Start" />
								<Border HeightRequest="140" StrokeThickness="0" BackgroundColor="#EEF2FF">
									<Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
									<Image Source="{Binding ThumbnailPath}" Aspect="AspectFill" />
								</Border>
								<Label Text="{Binding FileName}" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
								<Label Text="{Binding Details}" FontSize="12" TextColor="{StaticResource Gray500}" />
								<HorizontalStackLayout Spacing="6">
									<Button Text="★" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=ToggleFavoriteCommand}"
											CommandParameter="{Binding .}" />
									<Button Text="📌" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=TogglePinnedCommand}"
											CommandParameter="{Binding .}" />
									<Button Text="Edit" HeightRequest="32"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=EditPagesCommand}"
											CommandParameter="{Binding .}" />
									<Button Text="🗑" HeightRequest="32" BackgroundColor="#EF4444" TextColor="White"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=DeleteCommand}"
											CommandParameter="{Binding .}" />
								</HorizontalStackLayout>
							</VerticalStackLayout>
						</Border>
					</DataTemplate>
				</CollectionView.ItemTemplate>
			</CollectionView>

			<Border Style="{StaticResource Card}" IsVisible="{Binding HasRecycleBin}">
				<VerticalStackLayout Spacing="8">
					<Label Text="Recycle bin" FontAttributes="Bold" />
					<VerticalStackLayout BindableLayout.ItemsSource="{Binding RecycleBin}" Spacing="6">
						<BindableLayout.ItemTemplate>
							<DataTemplate x:DataType="models:RecycleBinDocument">
								<Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
									<VerticalStackLayout>
										<Label Text="{Binding FileName}" FontAttributes="Bold" LineBreakMode="MiddleTruncation" />
										<Label Text="{Binding Details}" FontSize="11" TextColor="{StaticResource Gray500}" />
									</VerticalStackLayout>
									<Button Grid.Column="1" Text="Restore" HeightRequest="36"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=RestoreCommand}"
											CommandParameter="{Binding .}" />
									<Button Grid.Column="2" Text="Delete forever" HeightRequest="36" TextColor="White" BackgroundColor="#EF4444"
											Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DocumentsViewModel}}, Path=DeletePermanentlyCommand}"
											CommandParameter="{Binding .}" />
								</Grid>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</VerticalStackLayout>
				</VerticalStackLayout>
			</Border>

			<Label Text="No documents yet. Tap Add to create your offline workspace." IsVisible="{Binding HasNoDocuments}" />
			<Label Text="{Binding Status}" TextColor="{StaticResource Primary}" />
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
