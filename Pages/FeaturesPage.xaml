<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="MauiApp.Pages.FeaturesPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:MauiApp.PageModels"
	x:DataType="vm:FeaturesViewModel"
	Title="Feature Control"
	BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

	<ContentPage.Resources>
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="StrokeThickness" Value="1" />
			<Setter Property="Padding" Value="16" />
			<Setter Property="Stroke" Value="{AppThemeBinding Light=#E5E7EB, Dark=#33333C}" />
			<Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark={StaticResource DarkSecondaryBackground}}" />
			<Setter Property="StrokeShape" Value="RoundRectangle 20" />
		</Style>
		<Style x:Key="SectionLabel" TargetType="Label">
			<Setter Property="FontAttributes" Value="Bold" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
		</Style>
		<Style x:Key="Small" TargetType="Button">
			<Setter Property="HeightRequest" Value="38" />
			<Setter Property="Padding" Value="14,0" />
			<Setter Property="CornerRadius" Value="19" />
			<Setter Property="FontSize" Value="13" />
		</Style>
	</ContentPage.Resources>

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="16" MaximumWidthRequest="820">
			<Label Text="Feature control" FontSize="28" FontAttributes="Bold"
				   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=White}" />
			<Label Text="Changes save immediately. Hidden tools disappear; disabled tools stay visible with a lock and your message." Style="{StaticResource SectionLabel}" FontAttributes="None" />

			<Border Style="{StaticResource Card}" Stroke="{StaticResource Primary}">
				<VerticalStackLayout Spacing="8">
					<HorizontalStackLayout Spacing="10">
						<Switch IsToggled="{Binding PreviewAsUser}" />
						<Label Text="Preview as user" FontAttributes="Bold" VerticalOptions="Center" />
					</HorizontalStackLayout>
					<Label Text="Turn this on, then open PDF Tools from the menu to verify hidden and disabled features without signing out."
						   Style="{StaticResource SectionLabel}" FontAttributes="None" FontSize="12" />
				</VerticalStackLayout>
			</Border>

			<Button Text="Save now" Command="{Binding SaveCommand}" HeightRequest="50" CornerRadius="25" FontAttributes="Bold"
					BackgroundColor="{StaticResource Primary}" TextColor="White" />
			<Label Text="{Binding Status}" TextColor="{StaticResource Primary}" />

			<Border Style="{StaticResource Card}">
				<VerticalStackLayout Spacing="10">
					<Label Text="APP-WIDE" Style="{StaticResource SectionLabel}" />

					<HorizontalStackLayout Spacing="10">
						<Switch IsToggled="{Binding AllowSignUp}" />
						<Label Text="Allow new users to sign up" VerticalOptions="Center" />
					</HorizontalStackLayout>

					<HorizontalStackLayout Spacing="10">
						<Switch IsToggled="{Binding MaintenanceMode}" />
						<Label Text="Maintenance mode (locks every tool for users)" VerticalOptions="Center" />
					</HorizontalStackLayout>
					<Entry Text="{Binding MaintenanceMessage}" Placeholder="Message shown during maintenance" IsVisible="{Binding MaintenanceMode}" />

					<HorizontalStackLayout Spacing="10">
						<Switch IsToggled="{Binding AnnouncementOn}" />
						<Label Text="Show an announcement banner on the home screen" VerticalOptions="Center" />
					</HorizontalStackLayout>
					<Entry Text="{Binding Announcement}" Placeholder="Announcement text" IsVisible="{Binding AnnouncementOn}" />
				</VerticalStackLayout>
			</Border>

			<FlexLayout Wrap="Wrap">
				<Button Text="Enable all" Command="{Binding EnableAllCommand}" Style="{StaticResource Small}" Margin="0,0,8,8" />
				<Button Text="Disable all" Command="{Binding DisableAllCommand}" Style="{StaticResource Small}" Margin="0,0,8,8" />
				<Button Text="Reset all" Command="{Binding ResetAllCommand}" Style="{StaticResource Small}" Margin="0,0,8,8" />
			</FlexLayout>

			<Label Text="TOOLS" Style="{StaticResource SectionLabel}" />
			<VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="10">
				<BindableLayout.ItemTemplate>
					<DataTemplate x:DataType="vm:FeatureRow">
						<Border Style="{StaticResource Card}" Padding="14">
							<VerticalStackLayout Spacing="8">
								<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
									<Label Text="{Binding Tool.Glyph}" FontSize="24" VerticalOptions="Center" />
									<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
										<Label Text="{Binding Tool.Title}" FontAttributes="Bold" />
										<Label Text="{Binding Tool.Description}" FontSize="12" Style="{StaticResource SectionLabel}" FontAttributes="None" />
									</VerticalStackLayout>
								</Grid>
								<FlexLayout Wrap="Wrap" AlignItems="Center">
									<Switch IsToggled="{Binding Visible}" />
									<Label Text="Visible" VerticalOptions="Center" Margin="6,0,20,0" />
									<Switch IsToggled="{Binding Enabled}" />
									<Label Text="Enabled" VerticalOptions="Center" Margin="6,0,0,0" />
								</FlexLayout>
								<Entry Text="{Binding Message}" Placeholder="Custom message shown when disabled (optional)" />
							</VerticalStackLayout>
						</Border>
					</DataTemplate>
				</BindableLayout.ItemTemplate>
			</VerticalStackLayout>
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
