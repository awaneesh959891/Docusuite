<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="MauiApp.Pages.LoginPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:MauiApp.PageModels"
	x:DataType="vm:LoginViewModel"
	Shell.NavBarIsVisible="False">

	<Grid>
		<Grid.Background>
			<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
				<GradientStop Color="#512BD4" Offset="0.0" />
				<GradientStop Color="#8B5CF6" Offset="0.6" />
				<GradientStop Color="#D600AA" Offset="1.0" />
			</LinearGradientBrush>
		</Grid.Background>

		<ScrollView VerticalOptions="Center">
			<VerticalStackLayout Padding="24" Spacing="22" MaximumWidthRequest="460">
				<VerticalStackLayout Spacing="4" HorizontalOptions="Center">
					<Label Text="📄" FontSize="52" HorizontalOptions="Center" />
					<Label Text="DocSuite" FontSize="34" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
					<Label Text="All-in-one PDF toolkit" FontSize="14" TextColor="#E6DFFF" HorizontalOptions="Center" />
				</VerticalStackLayout>

				<Border BackgroundColor="White" StrokeThickness="0" Padding="24">
					<Border.StrokeShape>
						<RoundRectangle CornerRadius="28" />
					</Border.StrokeShape>
					<Border.Shadow>
						<Shadow Brush="Black" Opacity="0.25" Radius="24" Offset="0,10" />
					</Border.Shadow>

					<VerticalStackLayout Spacing="12">
						<Label Text="{Binding Title}" FontSize="24" FontAttributes="Bold" TextColor="#1F2937" />
						<Label Text="{Binding Subtitle}" FontSize="13" TextColor="#6B7280" Margin="0,-8,0,6" />

						<Entry Text="{Binding Name}" Placeholder="Full name" IsVisible="{Binding IsSignUp}"
							   TextColor="#111827" PlaceholderColor="#9CA3AF" ReturnType="Next" />
						<Entry Text="{Binding Email}" Placeholder="Email address" Keyboard="Email"
							   TextColor="#111827" PlaceholderColor="#9CA3AF" ReturnType="Next" />
						<Entry Text="{Binding Password}" Placeholder="Password" IsPassword="{Binding HidePassword}"
							   TextColor="#111827" PlaceholderColor="#9CA3AF" ReturnType="Done"
							   ReturnCommand="{Binding SubmitCommand}" />
						<Entry Text="{Binding ConfirmPassword}" Placeholder="Confirm password" IsPassword="{Binding HidePassword}"
							   IsVisible="{Binding IsSignUp}" TextColor="#111827" PlaceholderColor="#9CA3AF" />

						<HorizontalStackLayout Spacing="8">
							<CheckBox IsChecked="{Binding ShowPassword}" Color="#512BD4" />
							<Label Text="Show password" VerticalOptions="Center" TextColor="#4B5563" />
						</HorizontalStackLayout>

						<Label Text="{Binding Error}" IsVisible="{Binding HasError}" TextColor="#DC2626" FontSize="13" />

						<Button Text="{Binding SubmitText}" Command="{Binding SubmitCommand}" HeightRequest="52" CornerRadius="26"
								FontAttributes="Bold" FontSize="16" BackgroundColor="#512BD4" TextColor="White" />
						<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#512BD4" />

						<HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
							<Label Text="{Binding SwitchText}" VerticalOptions="Center" TextColor="#6B7280" />
							<Button Text="{Binding SwitchAction}" Command="{Binding ToggleModeCommand}" BackgroundColor="Transparent"
									TextColor="#512BD4" FontAttributes="Bold" Padding="0" HeightRequest="40" />
						</HorizontalStackLayout>
					</VerticalStackLayout>
				</Border>
			</VerticalStackLayout>
		</ScrollView>
	</Grid>
</ContentPage>
