<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="MauiApp.Pages.PdfPreviewPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:pages="clr-namespace:MauiApp.Pages"
	x:DataType="pages:PdfPreviewPage"
	Shell.NavBarIsVisible="False"
	BackgroundColor="{AppThemeBinding Light=#E5E7EB, Dark=#111114}">

	<Grid RowDefinitions="Auto,*,Auto">
		<Grid Padding="16,20,16,12" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"
			  BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkSecondaryBackground}}">
			<VerticalStackLayout VerticalOptions="Center">
				<Label Text="{Binding Heading}" FontSize="18" FontAttributes="Bold" LineBreakMode="MiddleTruncation"
					   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=White}" />
				<Label Text="{Binding Info}" FontSize="12" TextColor="{StaticResource Gray500}" />
			</VerticalStackLayout>
			<Button Grid.Column="1" Text="Zoom −" Clicked="OnZoomOut" HeightRequest="38" Padding="12,0" CornerRadius="19" FontSize="13" />
			<Button Grid.Column="2" Text="Zoom +" Clicked="OnZoomIn" HeightRequest="38" Padding="12,0" CornerRadius="19" FontSize="13" />
		</Grid>

		<ScrollView Grid.Row="1" Orientation="Both">
			<VerticalStackLayout x:Name="PagesHost" Padding="16" Spacing="14" HorizontalOptions="Center" />
		</ScrollView>

		<Grid Grid.Row="2" Padding="16,10,16,16" ColumnDefinitions="*,*,*,*" ColumnSpacing="8"
			  BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkSecondaryBackground}}">
			<Button Text="Close" Clicked="OnClose" BackgroundColor="Transparent" BorderWidth="1" BorderColor="{StaticResource Gray400}"
					TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
			<Button Grid.Column="1" Text="Open" Clicked="OnOpen" />
			<Button Grid.Column="2" Text="Share" Clicked="OnShare" />
			<Button Grid.Column="3" Text="Save" Clicked="OnSave" BackgroundColor="#10B981" TextColor="White" />
		</Grid>
	</Grid>
</ContentPage>
