<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="MauiApp.Pages.PrivacyPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	xmlns:vm="clr-namespace:MauiApp.PageModels"
	x:DataType="vm:PrivacyViewModel"
	Title="Offline &amp; Privacy"
	BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

	<ScrollView>
		<VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="820">
			<Label Text="Offline &amp; Privacy" FontSize="28" FontAttributes="Bold"
				   TextColor="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark=White}" />

			<Border StrokeThickness="0" BackgroundColor="#EAFBF4" Padding="16">
				<Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
				<VerticalStackLayout Spacing="6">
					<Label Text="Processed on this device" FontSize="18" FontAttributes="Bold" TextColor="#047857" />
					<Label Text="DocSuite's PDF tools work locally. No account connection or internet access is required for PDF processing. Files are only sent through an external share/open action you start." TextColor="#065F46" />
					<Label Text="Files uploaded by DocSuite: 0" FontAttributes="Bold" TextColor="#065F46" />
				</VerticalStackLayout>
			</Border>

			<Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#33333C}"
					BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkSecondaryBackground}}" Padding="16">
				<Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
				<VerticalStackLayout Spacing="8">
					<Label Text="Local storage" FontSize="16" FontAttributes="Bold" />
					<Grid ColumnDefinitions="*,Auto">
						<Label Text="Workspace and generated files" />
						<Label Grid.Column="1" Text="{Binding LocalStorage}" FontAttributes="Bold" />
					</Grid>
					<Grid ColumnDefinitions="*,Auto">
						<Label Text="Temporary files and thumbnails" />
						<Label Grid.Column="1" Text="{Binding CacheStorage}" FontAttributes="Bold" />
					</Grid>
					<Grid ColumnDefinitions="*,Auto">
						<Label Text="Activity records" />
						<Label Grid.Column="1" Text="{Binding HistoryCount}" FontAttributes="Bold" />
					</Grid>
				</VerticalStackLayout>
			</Border>

			<Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#33333C}"
					BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource DarkSecondaryBackground}}" Padding="16">
				<Border.StrokeShape><RoundRectangle CornerRadius="18" /></Border.StrokeShape>
				<VerticalStackLayout Spacing="10">
					<Label Text="On-device data controls" FontSize="16" FontAttributes="Bold" />
					<HorizontalStackLayout Spacing="10">
						<Switch IsToggled="{Binding KeepHistory}" />
						<Label Text="Keep local activity history" VerticalOptions="Center" />
					</HorizontalStackLayout>
					<HorizontalStackLayout Spacing="10">
						<Switch IsToggled="{Binding AutoCleanCache}" />
						<Label Text="Clear temporary files on app launch" VerticalOptions="Center" />
					</HorizontalStackLayout>
					<Label Text="Automatically remove activity records older than" FontSize="13" />
					<Picker ItemsSource="{Binding HistoryRetentionOptions}" SelectedIndex="{Binding HistoryRetentionIndex}" />
					<Label Text="Retention only deletes local activity records, not generated PDFs." FontSize="12" TextColor="{StaticResource Gray500}" />
					<FlexLayout Wrap="Wrap" JustifyContent="Start">
						<Button Text="Clear temporary files and thumbnails" Command="{Binding ClearCacheCommand}" Margin="0,0,8,8" />
						<Button Text="Clear activity history" Command="{Binding ClearHistoryCommand}" Margin="0,0,8,8" />
						<Button Text="Refresh usage" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
					</FlexLayout>
					<Label Text="{Binding Status}" TextColor="{StaticResource Primary}" />
				</VerticalStackLayout>
			</Border>

			<Label Text="Local storage is not encrypted by the optional vault feature; the vault is not implemented yet. Use device-level encryption and a screen lock for sensitive files." FontSize="12" TextColor="{StaticResource Gray500}" />
		</VerticalStackLayout>
	</ScrollView>
</ContentPage>
